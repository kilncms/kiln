{
  "name": "kiln",
  "version": "0.4.0",
  "description": "Click-to-edit CMS for static sites. GitHub as the backend. Free hosting as the host.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "kiln": "cli/index.mjs"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.js",
    "dev": "cd worker && npx wrangler dev --local --port 8787",
    "deploy:test": "node scripts/release.mjs --staging",
    "deploy:prod": "node scripts/release.mjs",
    "propagate": "node scripts/propagate-bundles.mjs"
  },
  "dependencies": {
    "parse5": "^8.0.0",
    "yaml": "^2.9.0"
  },
  "peerDependencies": {
    "playwright-core": ">=1.40"
  },
  "peerDependenciesMeta": {
    "playwright-core": {
      "optional": true
    }
  },
  "devDependencies": {
    "dompurify": "^3.2.0",
    "esbuild": "^0.25.0",
    "wrangler": "^4.0.0"
  }
}
