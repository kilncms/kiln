    "prepack": "node ../scripts/pack-license.mjs",
    "postpack": "node ../scripts/pack-license.mjs --clean"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "cms",
    "kiln",
    "ai-agents",
    "website"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kilncms/kiln.git",
    "directory": "mcp"
  },
  "homepage": "https://kilncms.com",
  "bugs": {
    "url": "https://github.com/kilncms/kiln/issues"
  }
}
